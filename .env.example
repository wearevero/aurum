# ── Lisensi ────────────────────────────────────────────────
# Sumber baru aktif setelah Anda memeriksa syarat redistribusinya dan mencantumkan id-nya di sini.
LICENSE_REVIEWED=

# ── Lapis 1: harga spot internasional ──────────────────────
SPOT_PRIORITY=metalcharts,apininjas

METALCHARTS_API_KEY=
METALCHARTS_MONTHLY_BUDGET=180      # paket gratis = 200 request/bulan; sisakan margin
METALCHARTS_TTL=21600               # detik. 6 jam x 4 x 30 hari = 120 request/bulan

APININJAS_API_KEY=
APININJAS_PLAN=free                 # free | developer | business (free = non-komersial, tidak akan diaktifkan)
APININJAS_MONTHLY_BUDGET=500        # cek kuota sebenarnya di dashboard Anda
APININJAS_TTL=86400

# ── Kurs ───────────────────────────────────────────────────
FRANKFURTER_URL=https://api.frankfurter.dev/v1

# ── Lapis 2: harga ritel lokal (feed JSON) ─────────────────
# Array JSON. Lihat README untuk skema feed.
# LOCAL_FEEDS=[{"id":"toko-kami","name":"Harga Toko Kami","url":"https://example.com/prices.json","license":"milik sendiri"}]
LOCAL_TTL=3600
PORT=3000
